# Hostinger AI Router (OpenAI-compatible). Get base URL + key from the Hostinger dashboard.
AI_ROUTER_BASE_URL=
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=claude-haiku-5-5
ENABLE_RDAP=1
CORS_ORIGINS=*
# Gemini (Google AI Studio key). Enables photo reading on /analyze-image.
GEMINI_API_KEY=
# Optional model overrides (see app/llm.py for the routing):
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_RICH=gemini-3.1-flash-lite
# GEMINI_MODEL_FAST_IMAGE=gemini-3.1-flash-lite
# GEMINI_MODEL_DEEP=gemini-3.5-flash
# Needed when the server is reached through a public tunnel; the iOS app sends it.
APP_TOKEN=
